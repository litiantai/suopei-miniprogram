<view class="page" wx:if="{{o}}"><view class="page-head"><view><text class="eyebrow">{{o.code}}</text><view class="title">{{o.plate}}</view><view class="subtitle">{{o.model}} · {{o.workType}}</view></view><text class="badge">{{o.phase}}</text></view><view wx:if="{{o.needsReview}}" class="card warning">历史工单需在 Web 核对后启用</view><view class="card"><view class="section-title">车辆信息</view><view>{{o.summary||'暂无维修简述'}}</view><view class="muted">{{o.note}}</view><view wx:for="{{times}}" wx:key="index" class="time-row"><text>{{item[0]}}</text><text>{{item[1]}}</text></view></view><view wx:if="{{o.phase==='intake' && canCheck && !o.needsReview}}" class="card"><view class="section-title">录入检查</view><textarea placeholder="检查结果、损伤情况" value="{{note}}" bindinput="noteInput"/><button class="primary" bindtap="check">完成检查，进入派发</button></view><view wx:if="{{o.phase==='dispatch' && canDispatch}}" class="card"><view class="section-title">派发与计划</view><text class="footnote">时间格式：2026-11-10T09:00</text><text class="label">预计开工</text><input value="{{plans.plannedStartAt}}" data-key="plannedStartAt" bindinput="planField"/><text class="label">预计完工</text><input value="{{plans.plannedFinishAt}}" data-key="plannedFinishAt" bindinput="planField"/><text class="label">预计交车</text><input value="{{plans.promisedAt}}" data-key="promisedAt" bindinput="planField"/><view class="switch-row">需要保险索赔<switch checked="{{plans.claimApplicable}}" data-key="claimApplicable" bindchange="planSwitch" color="#205c4f"/></view><view class="switch-row">索赔办理完成<switch checked="{{plans.claimHandled}}" data-key="claimHandled" bindchange="planSwitch" color="#205c4f"/></view><view class="switch-row">需要配件<switch checked="{{plans.partsRequired}}" data-key="partsRequired" bindchange="planSwitch" color="#205c4f"/></view><view class="switch-row">配件到齐<switch checked="{{plans.partsReady}}" data-key="partsReady" bindchange="planSwitch" color="#205c4f"/></view><view class="switch-row">有索赔单<switch checked="{{plans.hasClaimSheet}}" data-key="hasClaimSheet" bindchange="planSwitch" color="#205c4f"/></view><button class="secondary" data-claim="{{true}}" bindtap="choose">上传索赔单图片</button><button class="secondary" bindtap="chooseClaimFile">选择索赔单 PDF 文件</button><view wx:for="{{attachments}}" wx:key="id"><button wx:if="{{item.purpose==='claim'}}" class="file" data-id="{{item.id}}" bindtap="openFile">{{item.filename}} ↗</button></view><button class="secondary" bindtap="savePlans">保存计划与业务标记</button><button class="primary" bindtap="dispatch">派工完成，进入维修</button></view>
<view wx:for="{{tasks}}" wx:key="id" wx:for-index="taskIndex" wx:for-item="task" class="card"><view class="row"><text class="section-title">{{task.typeName}}</text><text class="badge">{{task.status}}</text></view><view class="muted">负责人：{{task.assigneeName}}</view><view class="footnote">{{task.hint}}</view><view wx:if="{{task.canAssign}}"><picker range="{{users}}" range-key="name" value="{{task.assigneeIndex}}" data-index="{{taskIndex}}" bindchange="assignPick"><view class="picker">{{users[task.assigneeIndex].name||'选择维修人员'}} ▾</view></picker><button class="secondary" data-index="{{taskIndex}}" bindtap="assign">指派 / 改派（原因填写下方备注）</button></view><button wx:if="{{task.canEdit && o.phase==='repair' && (task.status==='pending'||task.status==='rework')}}" class="primary" data-id="{{task.id}}" bindtap="start">{{task.status==='rework'?'开始返工':'开始维修'}}</button><view wx:if="{{task.canEdit && task.status==='working' && o.phase==='repair'}}"><text class="footnote">{{task.requirementsText}}</text><text class="label">维修说明 {{task.requirements.description?'*':''}}</text><textarea value="{{task.description}}" data-index="{{taskIndex}}" data-key="description" bindinput="field" placeholder="维修内容与结果"/><text class="label">备注 {{task.requirements.remark?'*':''}}</text><textarea value="{{task.remark}}" data-index="{{taskIndex}}" data-key="remark" bindinput="field" placeholder="补充说明"/><button class="secondary" data-index="{{taskIndex}}" bindtap="choose" disabled="{{!!uploading}}">{{uploading||'＋ 拍照 / 上传图片视频'}}</button><block wx:if="{{task.paintEnabled}}"><text class="label">调漆数量（件）</text><input type="number" value="{{task.paintQuantity}}" data-index="{{taskIndex}}" data-key="paintQuantity" bindinput="field"/><view class="switch-row">小件<switch checked="{{task.smallPart}}" data-index="{{taskIndex}}" bindchange="smallPart" color="#205c4f"/></view></block><view class="button-row"><button class="secondary" data-index="{{taskIndex}}" data-submit="{{false}}" bindtap="report">保存草稿</button><button class="primary" data-index="{{taskIndex}}" data-submit="{{true}}" bindtap="report">提交结果</button></view></view><view wx:if="{{task.report}}" class="report"><text class="label">最新维修内容</text><view>{{task.report.description}}</view><view>{{task.report.remark}}</view></view><view wx:for="{{task.files}}" wx:key="id" wx:for-item="file" class="file-row"><button class="file" data-id="{{file.id}}" bindtap="openFile">{{file.filename}} ↗</button><button class="text-button" data-id="{{file.id}}" data-download="{{true}}" bindtap="openFile">下载</button></view></view>
<view class="card" wx:if="{{o.phase==='acceptance' && !o.acceptedAt && canAccept}}"><view class="section-title">整车验收</view><text class="footnote">请先查看维修记录和附件。需要返工时选择退回类型。</text><checkbox-group bindchange="rejectChange"><label wx:for="{{tasks}}" wx:key="id" class="check"><checkbox value="{{item.id}}" color="#205c4f"/>{{item.typeName}}</label></checkbox-group><textarea placeholder="验收备注 / 退回原因" value="{{note}}" bindinput="noteInput"/><view class="button-row"><button class="secondary" disabled="{{!rejected.length}}" bindtap="reject">退回选中</button><button class="primary" bindtap="accept">验收通过</button></view></view><view class="card" wx:if="{{o.acceptedAt && !o.deliveredAt && canHandover}}"><view class="section-title">客户提车确认</view><button class="primary" bindtap="handover">确认客户已实际提车</button></view><view class="card"><view class="section-title">备注与进度通报</view><textarea placeholder="填写进度或改派原因" value="{{note}}" bindinput="noteInput"/><button class="secondary" bindtap="addNote">添加通报</button></view><view class="card"><view class="section-title">历史时间线</view><view wx:for="{{o.events}}" wx:key="id" class="event"><text>{{item.actorName}} · {{item.kind}}</text><view class="muted">{{item.note}}</view><text class="footnote">{{item.at}}</text></view></view><view wx:if="{{videoUrl}}" class="video-overlay"><video src="{{videoUrl}}" controls autoplay/><button bindtap="closeVideo">关闭视频</button></view></view>
