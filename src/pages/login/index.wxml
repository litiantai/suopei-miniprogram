<view class="login"><view class="logo">索赔</view><view class="eyebrow">AFTERSALES WORKSPACE</view><view class="title">{{mustChange?'设置个人密码':'欢迎回到工作台'}}</view><view class="subtitle">每一步维修，清晰留痕。</view><view class="card"><block wx:if="!mustChange"><text class="label">员工账号</text><input placeholder="管理员开通的账号" value="{{username}}" data-field="username" bindinput="input"/><text class="label">密码</text><input password placeholder="请输入密码" value="{{password}}" data-field="password" bindinput="input"/><button class="primary" loading="{{busy}}" bindtap="login">登录工作台</button></block><block wx:else><text class="label">新密码（至少10位）</text><input password placeholder="请输入新密码" data-field="newPassword" bindinput="input"/><button class="primary" bindtap="change">保存并重新登录</button></block></view><text class="footnote">仅限已开通的白名单员工账号</text></view>
