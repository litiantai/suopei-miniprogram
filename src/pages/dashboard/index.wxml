<view class="page"><text class="eyebrow">OPERATIONS OVERVIEW</text><view class="title">运营看板</view><view class="subtitle">{{rangeText}}</view><view class="period"><button wx:for="{{[1,7,30]}}" wx:key="*this" class="{{days===item?'selected':''}}" data-days="{{item}}" bindtap="period">近 {{item}} 日</button></view><view class="card filters"><view class="button-row"><picker range="{{peopleNames}}" value="{{personIndex}}" data-key="personIndex" bindchange="pick"><view class="picker">{{peopleNames[personIndex]}} ▾</view></picker><picker range="{{typeNames}}" value="{{typeIndex}}" data-key="typeIndex" bindchange="pick"><view class="picker">{{typeNames[typeIndex]}} ▾</view></picker></view><picker range="{{workTypes}}" value="{{workTypeIndex}}" data-key="workTypeIndex" bindchange="pick"><view class="picker">{{workTypes[workTypeIndex]}} ▾</view></picker><view class="switch-row">按历史参与人员筛选<switch checked="{{history}}" bindchange="historyChange" color="#205c4f"/></view><view class="button-row"><picker mode="date" value="{{from}}" data-key="from" bindchange="date"><view class="picker">{{from||'开始日期'}} ▾</view></picker><picker mode="date" value="{{to}}" data-key="to" bindchange="date"><view class="picker">{{to||'结束日期'}} ▾</view></picker></view><button class="text-button" bindtap="toggleAdvanced">人员 / 类型多选筛选</button><view wx:if="{{advanced}}"><text class="label">人员（多选优先于单选）</text><checkbox-group bindchange="multiPeople"><label wx:for="{{users}}" wx:key="id" class="check"><checkbox value="{{item.id}}" color="#205c4f"/>{{item.name}}</label></checkbox-group><text class="label">维修类型（多选）</text><checkbox-group bindchange="multiTypes"><label wx:for="{{types}}" wx:key="id" class="check"><checkbox value="{{item.id}}" color="#205c4f"/>{{item.name}}</label></checkbox-group><view class="switch-row">必须包含全部选中类型<switch checked="{{allTypes}}" bindchange="typeMode" color="#205c4f"/></view></view><button class="text-button" bindtap="load" loading="{{busy}}">查询 / 刷新</button></view><block wx:if="{{data}}"><view class="metric-grid"><view wx:for="{{cards}}" wx:key="key" class="metric"><text class="muted">{{item.label}}</text><view class="number">{{item.value}}<text>{{item.unit}}</text></view></view></view><view class="summary"><text>经营摘要</text><view>{{data.summary}}</view></view><view class="card"><view class="section-title">六阶段车辆进度</view><view class="stage-grid"><view wx:for="{{stages}}" wx:key="key" data-stage="{{item.key}}" bindtap="drill"><text class="number">{{item.value}}</text><view>{{item.label}}</view></view></view></view><view class="card"><view class="section-title">未来三日交车</view><view wx:for="{{data.upcoming}}" wx:key="date" class="delivery"><text>{{item.date}}</text><view>预计 {{item.total}} · 已交 {{item.delivered}} · 未交 {{item.pending}}</view><text class="warning-text">{{item.unfinished}} 台未完工</text></view><view class="footnote">今日之前未交 {{data.metrics.previousUndelivered}} 台</view></view><view class="card"><view class="section-title">调漆数量 / 返工次数</view><view wx:for="{{data.byPerson}}" wx:key="id" class="person-stat"><view class="row"><text>{{item.name}}</text><text>调漆 {{item.paint}} 件 · 返工 {{item.reworks}} 次</text></view><view class="bar"><view style="width:{{item.paint/(data.metrics.paintQuantity||1)*100}}%"/></view><text class="footnote">其中小件 {{item.smallParts}} 件</text></view><view wx:if="{{!data.byPerson.length}}" class="empty">暂无统计记录</view><text class="footnote">多人返工分别归属，人员合计可能大于整体退回次数。</text></view><view class="card"><view class="section-title">逾期未交车辆</view><view wx:for="{{data.exceptions}}" wx:key="id" class="delivery" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="plate">{{item.plate}}</text><text>查看 →</text></view><view class="muted">{{item.model}}</view></view><view wx:if="{{!data.exceptions.length}}" class="empty">暂无逾期车辆</view></view></block></view>
