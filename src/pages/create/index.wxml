<view class="page"><view class="title">登记进店车辆</view><view class="subtitle">选择需要的维修类型，建立维修工单。</view><view class="card"><text class="label">车牌号码 *</text><input data-key="plate" bindinput="input" placeholder="请输入车牌"/><text class="label">车型 *</text><input data-key="model" bindinput="input" placeholder="请输入车型"/><text class="label">VIN</text><input data-key="vin" bindinput="input"/><text class="label">客户姓名</text><input data-key="customer" bindinput="input"/><text class="label">联系电话</text><input data-key="phone" bindinput="input" type="number"/><text class="label">施工类型</text><picker range="{{workTypes}}" value="{{workTypeIndex}}" bindchange="workType"><view class="picker">{{workTypes[workTypeIndex]}} ▾</view></picker><text class="label">维修类型 *</text><checkbox-group bindchange="typesChange"><label wx:for="{{types}}" wx:key="id" class="check"><checkbox value="{{item.id}}" color="#205c4f"/>{{item.name}}</label></checkbox-group><text class="label">维修内容简述</text><textarea data-key="summary" bindinput="input" placeholder="车辆损伤和维修需求"/><text class="label">保险公司</text><input data-key="insurer" bindinput="input"/><text class="label">查勘员</text><input data-key="adjuster" bindinput="input"/><text class="label">责任班组</text><input data-key="team" bindinput="input"/><text class="label">预估产值（元）</text><input data-key="estimateValue" bindinput="input" type="digit"/><view class="switch-row">需要保险索赔<switch checked="{{claimApplicable}}" data-key="claimApplicable" bindchange="switchValue" color="#205c4f"/></view><view class="switch-row">需要配件<switch checked="{{partsRequired}}" data-key="partsRequired" bindchange="switchValue" color="#205c4f"/></view><text class="label">备注</text><textarea data-key="note" bindinput="input"/><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{!selected.length}}">建立车辆工单</button></view></view>
