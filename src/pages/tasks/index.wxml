<view class="page"><view class="page-head"><view><text class="eyebrow">MY WORKSPACE</text><view class="title">{{userName}}的工作台</view><view class="subtitle">当前可查看 {{total}} 台次车辆</view></view><button class="text-button" bindtap="logout">退出</button></view><view class="quick-actions"><button wx:if="{{canDashboard}}" bindtap="dashboard">运营看板 ↗</button><button wx:if="{{canCreate}}" bindtap="create">＋ 登记车辆</button></view><view class="search"><input placeholder="搜索车牌 / 车型" bindinput="searchInput" bindconfirm="load" confirm-type="search"/><button class="text-button" bindtap="load">搜索</button></view><view class="tabs"><view class="{{tab==='pending'?'active':''}}" data-tab="pending" bindtap="switchTab">待处理</view><view class="{{tab==='working'?'active':''}}" data-tab="working" bindtap="switchTab">处理中</view><view class="{{tab==='acceptance'?'active':''}}" data-tab="acceptance" bindtap="switchTab">待验收</view><view class="{{tab==='done'?'active':''}}" data-tab="done" bindtap="switchTab">已处理</view></view><view wx:for="{{items}}" wx:key="id" class="card vehicle" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="plate">{{item.plate}}</text><text class="badge">{{item.phaseLabel}}</text></view><view class="muted">{{item.model}} · {{item.workType}}</view><view class="type-line">{{item.types}}</view><view class="card-footer"><text>预计交车 {{item.due}}</text><text>查看 →</text></view></view><view wx:if="{{!items.length}}" class="empty">暂无此类待办车辆</view></view>
